<!-- ════════════════════════════════════════════════════════
     PASO A: Pegar esto ANTES de </head> en el tema de Blogger
════════════════════════════════════════════════════════ -->

<!-- 1. Google Fonts (necesario para el diseño) -->
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=DM+Sans:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>

<!-- 2. CSS del proyecto desde GitHub Pages
     REEMPLAZA: TU-USUARIO → tu nombre de usuario GitHub
     REEMPLAZA: carwas-mc  → el nombre de tu repositorio  -->
<link rel="stylesheet" href="https://TU-USUARIO.github.io/carwas-mc/css/styles.css"/>

<!-- 3. Meta tags extras para SEO y redes sociales -->
<meta property="og:title" content="Carwas M&amp;C 173 — Lavado de Autos a Domicilio Cartago"/>
<meta property="og:description" content="Spa móvil profesional en Cartago, Costa Rica. Desde ₡5,000. Reservá al WhatsApp 8737-5227."/>
<meta name="theme-color" content="#f5c518"/>

<!-- ════════════════════════════════════════════════════════
     PASO B: Pegar esto ANTES de </body> en el tema de Blogger
════════════════════════════════════════════════════════ -->

<!-- JS del proyecto desde GitHub Pages -->
<script src="https://TU-USUARIO.github.io/carwas-mc/js/main.js" defer="defer"></script>

<!-- Helper para galería: placeholders si faltan imágenes -->
<script>
function mcImgPlaceholder(n) {
  return '&lt;div class="mc-img-placeholder"&gt;'
    + '&lt;svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"&gt;'
    + '&lt;rect x="3" y="3" width="18" height="18" rx="2"/&gt;'
    + '&lt;circle cx="8.5" cy="8.5" r="1.5"/&gt;'
    + '&lt;polyline points="21 15 16 10 5 21"/&gt;'
    + '&lt;/svg&gt;'
    + '&lt;span&gt;Foto ' + n + '&lt;br&gt;Subir imagen&lt;/span&gt;'
    + '&lt;/div&gt;';
}
</script>
